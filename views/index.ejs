<%- include('partials/ust') %>

<!-- Vitrin -->
<section class="vitrin">
  <div class="vitrin-yazi">
    <span class="el-yazisi">elden, gönülden...</span>
    <h1>Her ürünün arkasında bir <em>emek</em> var.</h1>
    <p>Örgüden seramiğe, ahşaptan takıya; el yapımı ürünleri doğrudan üreticisinden al. Ya da sen de mağazanı aç, ürettiklerini sat.</p>
    <div class="d-flex gap-2 flex-wrap">
      <a href="/urunler" class="btn-turuncu buyuk">Ürünlere göz at</a>
      <a href="<%= kullanici ? '/hesap/urun/yeni' : '/auth/kayit' %>" class="btn-cizgi buyuk">Mağazanı aç</a>
    </div>
  </div>
  <div class="vitrin-resimler" aria-hidden="true">
    <% yeniUrunler.slice(0, 3).forEach((u, i) => { %><img src="<%= u.resim %>" alt="" class="polaroid p<%= i %>"><% }) %>
  </div>
</section>

<% if (sonDuyuru) { %>
  <a href="/duyuru/<%= sonDuyuru.slug %>" class="duyuru-serit"><i class="bi bi-megaphone"></i> <%= sonDuyuru.baslik %> <i class="bi bi-arrow-right ms-auto"></i></a>
<% } %>

<!-- Kategoriler -->
<h2 class="bolum-baslik">Kategoriler</h2>
<div class="kategori-izgara">
  <% kategoriler.forEach(k => { %>
    <a href="/kategori/<%= k.slug %>" class="kategori-kart">
      <i class="bi bi-<%= k.ikon %>"></i>
      <span class="fw-semibold"><%= k.ad %></span>
      <span class="soluk kucuk"><%= k.urunSayisi %> ürün</span>
    </a>
  <% }) %>
</div>

<% if (takipUrunleri.length) { %>
  <h2 class="bolum-baslik">Takip ettiğin mağazalardan</h2>
  <div class="urun-izgara">
    <% takipUrunleri.forEach(u => { %><%- include('partials/urun-kart', { u }) %><% }) %>
  </div>
<% } %>

<div class="d-flex align-items-baseline justify-content-between">
  <h2 class="bolum-baslik">Yeni gelenler</h2>
  <a href="/urunler" class="kucuk fw-semibold turuncu">Hepsini gör <i class="bi bi-arrow-right"></i></a>
</div>
<div class="urun-izgara">
  <% yeniUrunler.forEach(u => { %><%- include('partials/urun-kart', { u }) %><% }) %>
</div>

<div class="row g-4 mt-2">
  <div class="col-lg-7">
    <h2 class="bolum-baslik">En çok sevilenler</h2>
    <div class="urun-izgara iki">
      <% sevilenler.forEach(u => { %><%- include('partials/urun-kart', { u }) %><% }) %>
    </div>
  </div>
  <div class="col-lg-5">
    <h2 class="bolum-baslik">Alıcılar ne diyor?</h2>
    <div class="d-grid gap-2">
      <% sonYorumlar.forEach(y => { %><%- include('partials/yorum', { y, urunGoster: true }) %><% }) %>
      <% if (sonYorumlar.length === 0) { %><p class="soluk">Henüz yorum yok.</p><% } %>
    </div>
  </div>
</div>

<% if (!kullanici) { %>
  <!-- Misafirlere üye olmanın ne kazandıracağını anlatan şerit -->
  <div class="davet-serit mt-5">
    <div>
      <div class="el-yazisi">Sen de üret, sen de sat!</div>
      <p class="mb-0">Üye ol, ürettiklerini birkaç dakikada mağazana ekle. Beğendiğin ürünleri favorile, siparişlerini takip et.</p>
    </div>
    <a href="/auth/kayit" class="btn-turuncu buyuk">Ücretsiz üye ol</a>
  </div>
<% } %>

<%- include('partials/alt') %>
