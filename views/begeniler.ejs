<%- include('partials/ust', { sayfaBaslik: 'Beğenilen Şarkılar · ' + uye.kullaniciAdi }) %>
<section class="album-ust" style="--renk: #5038a0">
  <div class="kalp-kapak"><i class="bi bi-heart-fill"></i></div>
  <div>
    <span class="kucuk">Liste</span>
    <h1>Beğenilen Şarkılar</h1>
    <p class="mb-0"><a href="/uye/<%= uye.kullaniciAdi %>" class="fw-semibold"><%= uye.kullaniciAdi %></a> · <%= sarkilar.length %> şarkı</p>
  </div>
</section>

<% if (sarkilar.length) { %>
  <button class="cal-btn buyuk-cal my-3" id="hepsini-cal" aria-label="Hepsini çal"><i class="bi bi-play-fill"></i></button>
  <div class="liste">
    <% sarkilar.forEach((s, i) => { %><%- include('partials/satir', { s, sira: i + 1 }) %><% }) %>
  </div>
<% } else { %>
  <p class="soluk mt-4">Henüz beğenilen şarkı yok. Şarkıların yanındaki <i class="bi bi-heart"></i> ile ekleyebilirsin.</p>
<% } %>
<%- include('partials/alt') %>
