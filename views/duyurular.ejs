<%- include('partials/ust', { sayfaBaslik: 'Duyurular' }) %>
<div class="sayfa-ust"><h1>Duyurular</h1></div>
<div class="d-grid gap-2">
  <% duyurular.forEach(d => { %>
    <a href="/duyuru/<%= d.slug %>" class="kutu duyuru-kutu">
      <i class="bi bi-megaphone turuncu fs-4"></i>
      <div>
        <div class="fw-medium"><%= d.baslik %></div>
        <div class="soluk kucuk"><%= tarihYaz(d.tarih) %></div>
      </div>
    </a>
  <% }) %>
</div>
<%- include('partials/alt') %>
