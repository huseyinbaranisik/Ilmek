<%- include('partials/ust', { sayfaBaslik: 'Galeri' }) %>
<div class="sayfa-ust"><div><h1>Galeri</h1><p class="soluk mb-0">Atölyelerden kareler</p></div></div>
<div class="galeri-izgara">
  <% resimler.forEach(r => { %>
    <a href="#resim-<%= r.id %>" class="galeri-kart">
      <img src="<%= r.resim %>" alt="<%= r.aciklama %>">
      <span class="el-yazisi"><%= r.aciklama %></span>
    </a>
  <% }) %>
</div>

<!-- Büyük görünüm: adres #resim-ID olunca CSS (:target) ile açılır, JavaScript gerekmez -->
<% resimler.forEach(r => { %>
  <a href="#" class="buyut" id="resim-<%= r.id %>">
    <img src="<%= r.resim %>" alt="<%= r.aciklama %>">
    <span><%= r.aciklama %></span>
  </a>
<% }) %>
<%- include('partials/alt') %>
