<%- include('partials/ust', { sayfaBaslik: kategori ? kategori.ad : 'Tüm örgüler' }) %>
<div class="sayfa-ust">
  <div>
    <h1><% if (kategori) { %><i class="bi bi-<%= kategori.ikon %>"></i> <%= kategori.ad %><% } else { %>Tüm örgüler<% } %></h1>
    <p class="soluk mb-0"><%= toplam %> el örgüsü ürün<%= iplik ? ' · ' + iplik + ' iplikten' : '' %></p>
  </div>
</div>

<!-- İplik türü çipleri: tıklanınca adrese ?iplik=Alpaka eklenir (diğer seçimler korunur) -->
<div class="iplik-cipleri">
  <a href="?sirala=<%= sirala %>&min=<%= min %>&max=<%= max %>" class="<%= !iplik ? 'aktif' : '' %>">Bütün iplikler</a>
  <% IPLIKLER.forEach(i => { %>
    <a href="?iplik=<%= encodeURIComponent(i) %>&sirala=<%= sirala %>&min=<%= min %>&max=<%= max %>" class="<%= iplik === i ? 'aktif' : '' %>"><%= i %></a>
  <% }) %>
</div>

<!-- Sıralama ve fiyat aralığı: GET formu, değerler adreste görünür (?sirala=ucuz&min=100&max=500) -->
<form method="get" class="suzgec">
  <% if (iplik) { %><input type="hidden" name="iplik" value="<%= iplik %>"><% } %>
  <label class="kucuk soluk" for="sirala">Sırala</label>
  <select name="sirala" id="sirala" class="giris-kutu" onchange="this.form.submit()">
    <% Object.entries(SIRALAMALAR).forEach(([anahtar, s]) => { %>
      <option value="<%= anahtar %>" <%= sirala === anahtar ? 'selected' : '' %>><%= s.ad %></option>
    <% }) %>
  </select>
  <label class="kucuk soluk ms-sm-3" for="min">Fiyat</label>
  <input type="number" name="min" id="min" class="giris-kutu fiyat-kutu" placeholder="en az" min="0" value="<%= min %>">
  <span class="soluk">–</span>
  <input type="number" name="max" class="giris-kutu fiyat-kutu" placeholder="en çok" min="0" value="<%= max %>" aria-label="En çok">
  <button class="btn-cizgi">Uygula</button>
  <% if (min || max || iplik) { %><a href="?sirala=<%= sirala %>" class="kucuk soluk">temizle</a><% } %>
</form>

<div class="urun-izgara">
  <% urunler.forEach(u => { %><%- include('partials/urun-kart', { u }) %><% }) %>
</div>
<% if (urunler.length === 0) { %>
  <div class="bos-durum"><i class="bi bi-basket"></i><p>Bu seçime uygun örgü yok.</p></div>
<% } %>

<!-- Sayfalama: diğer seçimler (iplik, sıralama, fiyat) adreste korunur -->
<% if (sayfaSayisi > 1) { %>
  <% const adres = (s) => '?sayfa=' + s + '&sirala=' + sirala + '&min=' + min + '&max=' + max + (iplik ? '&iplik=' + encodeURIComponent(iplik) : ''); %>
  <nav class="sayfalama" aria-label="Sayfalar">
    <% if (sayfa > 1) { %><a href="<%= adres(sayfa - 1) %>" aria-label="Önceki sayfa"><i class="bi bi-chevron-left"></i></a><% } %>
    <% for (let s = 1; s <= sayfaSayisi; s++) { %>
      <a href="<%= adres(s) %>" class="<%= s === sayfa ? 'aktif' : '' %>"><%= s %></a>
    <% } %>
    <% if (sayfa < sayfaSayisi) { %><a href="<%= adres(sayfa + 1) %>" aria-label="Sonraki sayfa"><i class="bi bi-chevron-right"></i></a><% } %>
  </nav>
<% } %>
<%- include('partials/alt') %>
