<%- include('partials/ust', { sayfaBaslik: 'Arama' }) %>
<div class="sayfa-ust"><h1>"<%= q %>" için sonuçlar</h1></div>

<% if (urunler.length === 0 && magazalar.length === 0) { %>
  <div class="bos-durum"><i class="bi bi-search"></i><p>Sonuç bulunamadı. Başka bir kelime deneyin.</p></div>
<% } %>

<% if (magazalar.length) { %>
  <h2 class="bolum-baslik">Mağazalar</h2>
  <div class="d-flex flex-wrap gap-2 mb-2">
    <% magazalar.forEach(k => { %>
      <a href="/magaza/<%= k.kullaniciAdi %>" class="uye-cip"><span class="avatar kucuk-avatar"><%= k.kullaniciAdi[0].toUpperCase() %></span><%= k.magazaAdi || k.kullaniciAdi %></a>
    <% }) %>
  </div>
<% } %>

<% if (urunler.length) { %>
  <h2 class="bolum-baslik">Ürünler <span class="soluk fs-6">(<%= urunler.length %>)</span></h2>
  <div class="urun-izgara">
    <% urunler.forEach(u => { %><%- include('partials/urun-kart', { u }) %><% }) %>
  </div>
<% } %>
<%- include('partials/alt') %>
