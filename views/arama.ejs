<%- include('partials/ust', { sayfaBaslik: 'Arama' }) %>
<h2 class="bolum-baslik">"<%= q %>" için sonuçlar</h2>
<% if (sonuclar.length === 0 && uyeSonuclar.length === 0) { %>
  <p class="soluk">Sonuç bulunamadı. Başka bir şarkı, sanatçı, albüm ya da üye adı deneyin.</p>
<% } %>

<% if (sonuclar.length) { %>
  <h3 class="fs-5 fw-bold mt-3 mb-2">Şarkılar</h3>
  <div class="liste">
    <% sonuclar.forEach((s, i) => { %><%- include('partials/satir', { s, sira: i + 1 }) %><% }) %>
  </div>
<% } %>

<% if (uyeSonuclar.length) { %>
  <h3 class="fs-5 fw-bold mt-4 mb-2">Üyeler</h3>
  <div class="d-flex flex-wrap gap-2">
    <% uyeSonuclar.forEach(k => { %>
      <a href="/uye/<%= k.kullaniciAdi %>" class="uye-cip"><span class="avatar kucuk-avatar"><%= k.kullaniciAdi[0].toUpperCase() %></span><%= k.kullaniciAdi %></a>
    <% }) %>
  </div>
<% } %>
<%- include('partials/alt') %>
