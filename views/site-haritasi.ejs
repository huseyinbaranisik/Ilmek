<%- include('partials/ust', { sayfaBaslik: 'Site haritası' }) %>
<div class="sayfa-ust"><h1>Site haritası</h1></div>
<div class="row g-3">
  <div class="col-md-4"><div class="kutu h-100">
    <div class="turuncu fw-semibold mb-2">Sayfalar</div>
    <ul class="harita">
      <li><a href="/">Ana sayfa</a></li>
      <li><a href="/urunler">Tüm ürünler</a></li>
      <li><a href="/magazalar">Mağazalar</a>
        <ul><% magazalar.forEach(m => { %><li><a href="/magaza/<%= m.kullaniciAdi %>"><%= m.magazaAdi || m.kullaniciAdi %></a></li><% }) %></ul>
      </li>
      <li><a href="/galeri">Galeri</a></li>
      <li><a href="/duyurular">Duyurular</a></li>
      <li><a href="/sss">S.S.S.</a></li>
      <li><a href="/auth/giris">Giriş yap</a> · <a href="/auth/kayit">Üye ol</a></li>
    </ul>
  </div></div>
  <div class="col-md-4"><div class="kutu h-100">
    <div class="turuncu fw-semibold mb-2">Kategoriler ve ürünler</div>
    <ul class="harita">
      <% kategoriler.forEach(k => { %>
        <li><a href="/kategori/<%= k.slug %>"><%= k.ad %></a>
          <ul><% k.urunler.forEach(u => { %><li><a href="/urun/<%= u.slug %>"><%= u.baslik %></a></li><% }) %></ul>
        </li>
      <% }) %>
    </ul>
  </div></div>
  <div class="col-md-4"><div class="kutu h-100">
    <div class="turuncu fw-semibold mb-2">Duyurular</div>
    <ul class="harita">
      <% duyurular.forEach(d => { %><li><a href="/duyuru/<%= d.slug %>"><%= d.baslik %></a></li><% }) %>
    </ul>
    <p class="soluk kucuk mt-3 mb-0">Arama motorları için: <a href="/sitemap.xml">/sitemap.xml</a></p>
  </div></div>
</div>
<%- include('partials/alt') %>
