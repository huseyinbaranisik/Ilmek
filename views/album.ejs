<%- include('partials/ust', { sayfaBaslik: album.album }) %>
<section class="album-ust" style="--renk: <%= album.renk %>">
  <img src="<%= album.kapak %>" alt="<%= album.album %> kapağı">
  <div>
    <span class="kucuk">Albüm</span>
    <h1><%= album.album %></h1>
    <p class="mb-0"><%= album.sanatci %> · <%= sarkilar.length %> şarkı · <%= kisaSayi(sarkilar.reduce((t, s) => t + s.dinlenme, 0)) %> dinlenme</p>
  </div>
</section>
<button class="cal-btn buyuk-cal my-3" id="hepsini-cal" aria-label="Albümü çal"><i class="bi bi-play-fill"></i></button>
<div class="liste">
  <% sarkilar.forEach((s, i) => { %><%- include('partials/satir', { s, sira: i + 1 }) %><% }) %>
</div>
<%- include('partials/alt') %>
