<%- include('../partials/ust', { sayfaBaslik: 'Şarkı yükle' }) %>
<div class="kutu form-kutu genis">
  <h1 class="fs-4 mb-1"><i class="bi bi-upload turuncu"></i> Şarkı yükle</h1>
  <p class="soluk kucuk">
    <% if (kullanici.admin) { %>Yönetici olduğun için şarkın hemen yayınlanacak.<% } else { %>Şarkın yönetici onayından sonra yayınlanacak. Onay durumunu profil sayfanda görebilirsin.<% } %>
  </p>
  <!-- Dosya yüklendiği için enctype="multipart/form-data" şart.
       CSRF anahtarı adreste (?_csrf=...) gidiyor, çünkü csurf multer'dan önce çalışır. -->
  <form action="/hesap/yukle?_csrf=<%= csrfToken %>" method="post" enctype="multipart/form-data" class="row g-2">
    <div class="col-md-4"><input name="baslik" class="giris-kutu w-100" placeholder="Şarkı adı" required maxlength="100"></div>
    <div class="col-md-4"><input name="sanatci" class="giris-kutu w-100" placeholder="Sanatçı" required maxlength="100"></div>
    <div class="col-md-4">
      <input name="album" class="giris-kutu w-100" placeholder="Albüm" required maxlength="100" list="albumler">
      <datalist id="albumler"><% albumler.forEach(a => { %><option value="<%= a.album %>"><% }) %></datalist>
    </div>
    <div class="col-md-5"><label class="soluk kucuk">Ses dosyası (mp3, wav, ogg · en fazla 20 MB)</label><input type="file" name="ses" accept=".mp3,.wav,.ogg" class="giris-kutu w-100" required></div>
    <div class="col-md-5"><label class="soluk kucuk">Kapak (albüm zaten varsa boş bırakılabilir)</label><input type="file" name="kapak" accept=".jpg,.jpeg,.png,.webp,.gif" class="giris-kutu w-100"></div>
    <div class="col-md-2"><label class="soluk kucuk">Kapak rengi</label><input type="color" name="renk" value="#3C3489" class="giris-kutu w-100 renk-sec"></div>
    <div class="col-12"><button class="btn-turuncu buyuk mt-2">Yükle</button></div>
  </form>
</div>
<%- include('../partials/alt') %>
