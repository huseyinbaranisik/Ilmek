<%- include('../partials/ust', { sayfaBaslik: 'Admin paneli' }) %>
<%- include('../partials/admin-menu') %>

<div class="row g-2 mb-4">
  <% [
       ['Toplam ziyaretçi', ziyaretci.toLocaleString('tr-TR'), 'bi-eye', null],
       ['Şu an çevrimiçi', online, 'bi-broadcast', null],
       ['Yayındaki ürün', sayilar.urun, 'bi-grid', null],
       ['Onay bekleyen ürün', sayilar.bekleyen, 'bi-hourglass-split', '/admin/urunler'],
       ['Üye', sayilar.kullanici, 'bi-people', '/admin/kullanicilar'],
       ['Sipariş (teslim)', sayilar.siparis + ' (' + sayilar.teslim + ')', 'bi-box-seam', '/admin/siparisler'],
       ['Toplam satış', tl(sayilar.ciro), 'bi-cash-coin', null],
       ['Yorum / favori', sayilar.yorum + ' / ' + sayilar.favori, 'bi-heart', null],
       ['Cevapsız soru', sayilar.cevapsiz, 'bi-question-circle', '/admin/sss'],
     ].forEach(([ad, deger, ikon, adres]) => { %>
    <div class="col-6 col-md-4 col-lg-3">
      <div class="kutu sayi-kutu">
        <i class="bi <%= ikon %>"></i>
        <span class="soluk kucuk"><%= ad %></span>
        <b><%= deger %></b>
        <% if (adres) { %><a href="<%= adres %>" class="kucuk turuncu">Görüntüle <i class="bi bi-arrow-right"></i></a><% } %>
      </div>
    </div>
  <% }) %>
</div>

<div class="row g-4">
  <div class="col-lg-5">
    <h2 class="bolum-baslik">Siparişlerin durumu</h2>
    <!-- GROUP BY durum ile sayıldı -->
    <div class="kutu d-grid gap-2">
      <% durumlar.forEach(d => { %>
        <div class="d-flex align-items-center gap-2"><%- include('../partials/durum', { d: d.durum }) %><b class="ms-auto"><%= d.sayi %></b></div>
      <% }) %>
      <% if (durumlar.length === 0) { %><span class="soluk">Henüz sipariş yok.</span><% } %>
    </div>
  </div>
  <div class="col-lg-7">
    <h2 class="bolum-baslik">En çok görüntülenen 5 ürün</h2>
    <div class="liste">
      <% populer.forEach((u, i) => { %>
        <a href="/urun/<%= u.slug %>" class="satir">
          <span class="soluk"><%= i + 1 %></span>
          <img src="<%= u.resim %>" alt="" class="mini-resim">
          <span class="flex-grow-1 min-w-0"><span class="satir-baslik d-block text-truncate"><%= u.baslik %></span><span class="soluk kucuk"><%= u.kullanici.magazaAdi || u.kullanici.kullaniciAdi %></span></span>
          <span class="kucuk"><i class="bi bi-eye"></i> <%= u.goruntulenme %></span>
        </a>
      <% }) %>
    </div>
  </div>
</div>
<%- include('../partials/alt') %>
