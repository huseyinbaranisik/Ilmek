<%- include('../partials/ust', { sayfaBaslik: 'Admin paneli' }) %>
<%- include('../partials/admin-menu') %>

<div class="row g-2 mb-4">
  <div class="col-6 col-md-4 col-lg-2"><div class="kutu sayi-kutu"><span class="soluk kucuk">Toplam ziyaretçi</span><b><%= ziyaretci.toLocaleString('tr-TR') %></b></div></div>
  <div class="col-6 col-md-4 col-lg-2"><div class="kutu sayi-kutu"><span class="soluk kucuk">Şu an çevrimiçi</span><b class="yesil"><%= online %></b></div></div>
  <div class="col-6 col-md-4 col-lg-2"><div class="kutu sayi-kutu"><span class="soluk kucuk">Şarkı / üye</span><b><%= sayilar.sarki %> / <%= sayilar.kullanici %></b></div></div>
  <div class="col-6 col-md-4 col-lg-2"><div class="kutu sayi-kutu"><span class="soluk kucuk">İnceleme</span><b><%= sayilar.inceleme %></b></div></div>
  <div class="col-6 col-md-4 col-lg-2"><a href="/admin/sarkilar" class="kutu sayi-kutu d-block"><span class="soluk kucuk">Onay bekleyen</span><b class="sari"><%= sayilar.bekleyen %></b></a></div>
  <div class="col-6 col-md-4 col-lg-2"><a href="/admin/sss" class="kutu sayi-kutu d-block"><span class="soluk kucuk">Cevapsız soru</span><b class="sari"><%= sayilar.cevapsiz %></b></a></div>
</div>

<h2 class="bolum-baslik">En çok dinlenen 5 şarkı</h2>
<div class="liste">
  <% populer.forEach((s, i) => { %><%- include('../partials/satir', { s, sira: i + 1 }) %><% }) %>
</div>
<%- include('../partials/alt') %>
