<%- include('../partials/ust', { sayfaBaslik: 'Kullanıcılar · Admin' }) %>
<%- include('../partials/admin-menu') %>

<div class="liste">
  <% kullanicilar.forEach(k => { %>
    <div class="satir">
      <div class="avatar kucuk-avatar"><%= k.kullaniciAdi[0].toUpperCase() %></div>
      <div class="flex-grow-1 min-w-0">
        <a href="/magaza/<%= k.kullaniciAdi %>" class="satir-baslik"><%= k.kullaniciAdi %></a>
        <% if (k.magazaAdi) { %><span class="soluk kucuk">· <%= k.magazaAdi %></span><% } %>
        <div class="soluk kucuk">üyelik: <%= tarihYaz(k.createdAt) %> · <%= k.urunSayisi %> ürün · <%= k.siparisSayisi %> sipariş verdi</div>
      </div>
      <span class="rozet <%= k.rol.ad === 'Admin' ? 'sari-rozet' : 'yesil-rozet' %>"><%= k.rol.ad %></span>
    </div>
  <% }) %>
</div>
<%- include('../partials/alt') %>
