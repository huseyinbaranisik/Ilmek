<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= typeof sayfaBaslik !== 'undefined' ? sayfaBaslik + ' · İlmek' : 'İlmek · el örgüsü pazarı' %></title>
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/vendor/inter/index.css"><!-- gövde yazısı -->
  <link rel="stylesheet" href="/vendor/fraunces/index.css"><!-- başlıklar -->
  <link rel="stylesheet" href="/vendor/caveat/index.css"><!-- el yazısı notlar -->
  <link rel="stylesheet" href="/css/stil.css">
  <script>
    // Koyu tema: sayfa çizilmeden ÖNCE uygulanır, yoksa sayfa bir an beyaz yanıp söner.
    // Seçim localStorage'da "tema" adıyla durur; hiç seçilmediyse bilgisayarın ayarına bakılır.
    var tema = localStorage.getItem('tema');
    if (!tema) tema = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'koyu' : 'acik';
    if (tema === 'koyu') {
      document.documentElement.setAttribute('data-tema', 'koyu');
      document.documentElement.setAttribute('data-bs-theme', 'dark');   // Bootstrap'in açılır menüleri de koyu olsun
    }
  </script>
</head>
<body>

<!-- ===== ÜST MENÜ: Bootstrap navbar. Telefonda sağdaki düğmeyle açılıp kapanır (navbar-toggler + collapse) ===== -->
<header class="site-ust">
  <nav class="navbar navbar-expand-lg">
    <div class="container">
      <a href="/" class="navbar-brand logo">
        <img src="/img/logo.svg" alt="">
        <span>İlmek<small>el örgüsü pazarı</small></span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ustMenu" aria-controls="ustMenu" aria-expanded="false" aria-label="Menüyü aç">
        <i class="bi bi-list"></i>
      </button>

      <div class="collapse navbar-collapse" id="ustMenu">
        <form action="/" method="get" class="arama mx-lg-4 my-3 my-lg-0">
          <i class="bi bi-search"></i>
          <input type="search" name="q" placeholder="Kazak, bere, amigurumi, örgücü..." value="<%= typeof q !== 'undefined' ? q : '' %>" aria-label="Ara">
        </form>
        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
          <!-- Açık / koyu tema düğmesi: site.js tıklanınca temayı değiştirir -->
          <li class="nav-item"><button type="button" class="tema-dugme" id="tema-dugme" aria-label="Koyu / açık tema" title="Koyu / açık tema"><i class="bi bi-moon"></i><i class="bi bi-sun"></i></button></li>
          <li class="nav-item"><a class="nav-link <%= yol === '/magazalar' ? 'active' : '' %>" href="/magazalar"><i class="bi bi-shop"></i> Örgücüler</a></li>
          <!-- Sepet: içindeki ürün sayısını site.js tarayıcıdaki sepetten okuyup yazar -->
          <li class="nav-item"><a class="nav-link <%= yol === '/sepet' ? 'active' : '' %>" href="/sepet"><i class="bi bi-bag"></i> Sepet <span class="rozet kiremit-rozet" id="sepet-sayi" hidden>0</span></a></li>
          <% if (kullanici) { %>
            <li class="nav-item"><a class="nav-link <%= yol === '/hesap/favorilerim' ? 'active' : '' %>" href="/hesap/favorilerim"><i class="bi bi-heart"></i> Favoriler</a></li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="avatar kucuk-avatar"><%= kullanici.ad[0].toUpperCase() %></span> <%= kullanici.ad %>
                <% if (yeniSiparis) { %><span class="rozet sari-rozet" title="Kargoya verilecek sipariş"><%= yeniSiparis %></span><% } %>
              </a>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><h6 class="dropdown-header">Alışveriş</h6></li>
                <li><a class="dropdown-item" href="/hesap/siparislerim"><i class="bi bi-box-seam"></i> Siparişlerim</a></li>
                <li><a class="dropdown-item" href="/hesap/favorilerim"><i class="bi bi-heart"></i> Favorilerim</a></li>
                <li><a class="dropdown-item" href="/hesap/bilgilerim"><i class="bi bi-person-vcard"></i> Hesap bilgilerim</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><h6 class="dropdown-header">Mağazam</h6></li>
                <li><a class="dropdown-item" href="/hesap/gelen-siparisler"><i class="bi bi-inbox"></i> Gelen siparişler <% if (yeniSiparis) { %><span class="rozet sari-rozet"><%= yeniSiparis %></span><% } %></a></li>
                <li><a class="dropdown-item" href="/hesap/urunlerim"><i class="bi bi-grid"></i> Ürünlerim</a></li>
                <li><a class="dropdown-item" href="/magaza/<%= kullanici.ad %>"><i class="bi bi-shop-window"></i> Mağaza sayfam</a></li>
                <% if (kullanici.admin) { %>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item" href="/admin"><i class="bi bi-speedometer2"></i> Admin paneli</a></li>
                <% } %>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <form action="/auth/cikis" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="dropdown-item"><i class="bi bi-box-arrow-right"></i> Çıkış yap</button>
                  </form>
                </li>
              </ul>
            </li>
            <li class="nav-item ms-lg-2"><a href="/hesap/urun/yeni" class="btn-turuncu"><i class="bi bi-plus-lg"></i> Ürün ekle</a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/auth/giris">Giriş yap</a></li>
            <li class="nav-item ms-lg-2"><a href="/auth/kayit" class="btn-turuncu">Üye ol</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Kategori şeridi: telefonda yana kaydırılır -->
  <div class="kategori-serit">
    <div class="container">
      <a href="/urunler" class="<%= yol === '/urunler' ? 'aktif' : '' %>"><i class="bi bi-grid-3x3-gap"></i> Tüm örgüler</a>
      <% menuKategoriler.forEach(k => { %>
        <a href="/kategori/<%= k.slug %>" class="<%= yol === '/kategori/' + k.slug ? 'aktif' : '' %>"><i class="bi bi-<%= k.ikon %>"></i> <%= k.ad %></a>
      <% }) %>
      <span class="ayrac"></span>
      <a href="/galeri" class="<%= yol === '/galeri' ? 'aktif' : '' %>">Galeri</a>
      <a href="/duyurular" class="<%= yol.startsWith('/duyuru') ? 'aktif' : '' %>">Duyurular</a>
      <a href="/sss" class="<%= yol === '/sss' ? 'aktif' : '' %>">S.S.S.</a>
    </div>
  </div>
</header>

<main class="container icerik">
<% if (mesaj) { %>
  <div class="bilgi <%= mesaj.tur %>"><i class="bi <%= mesaj.tur === 'hata' ? 'bi-exclamation-circle' : 'bi-check-circle' %>"></i> <%= mesaj.metin %></div>
<% } %>
