<%# İnceleme kartı. i = inceleme. sarkiGoster: true ise şarkının kapağı ve adı da gösterilir (ana sayfa, profil) %>
<div class="inceleme">
  <% if (sarkiGoster) { %>
    <a href="/sarki/<%= i.sarki.slug %>"><img src="<%= i.sarki.kapak %>" alt="" class="inceleme-kapak"></a>
  <% } %>
  <div class="flex-grow-1 min-w-0">
    <% if (sarkiGoster) { %>
      <a href="/sarki/<%= i.sarki.slug %>" class="fw-medium"><%= i.sarki.baslik %></a>
      <span class="soluk kucuk">· <%= i.sarki.sanatci %></span><br>
    <% } %>
    <span class="yildiz"><%= yildiz(i.puan) %></span>
    <% if (i.kullanici) { %><a href="/uye/<%= i.kullanici.kullaniciAdi %>" class="kucuk ms-1"><i class="bi bi-person-circle"></i> <%= i.kullanici.kullaniciAdi %></a><% } %>
    <span class="soluk kucuk">· <%= tarihYaz(i.updatedAt) %></span>
    <% if (i.yorum) { %><p class="mb-0 mt-1 inceleme-yorum"><%= i.yorum %></p><% } %>
  </div>
  <% if (kullanici && (kullanici.id === i.kullaniciId || kullanici.admin)) { %>
    <form action="/hesap/inceleme/<%= i.id %>/sil" method="post" onsubmit="return confirm('Bu inceleme silinsin mi?')">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn-sil" title="Sil"><i class="bi bi-trash"></i></button>
    </form>
  <% } %>
</div>
